# 复制为 .env 后填写。不填 LLM_API_KEY 时自动使用离线假模型（MockChatModel）。
# 默认使用 DeepSeek；换通义千问时改成：
#   LLM_MODEL=qwen-plus
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# 有 key 但想临时用假模型时设为 1
# MOCK_LLM=1

# 可选：LangSmith 链路追踪（文档 LangSmith Observability），能看到每一步的输入输出
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=customer-support-agent
